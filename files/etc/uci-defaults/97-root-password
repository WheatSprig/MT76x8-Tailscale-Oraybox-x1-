#!/bin/sh
# 首次开机：设置 root 密码，保证 SSH 和网页控制台都能登录。
#
# 构建时如果配置了仓库 secret ROOT_PASSWORD_HASH，工作流会把下面的
# ROOT_HASH 替换成你自己的密码哈希（推荐）；否则使用默认密码 mt76x8。
#
# 注意：默认密码只是为了让你能第一次进去，进去后请立刻在控制台「修改密码」
# 或 SSH 里执行 passwd 改掉。
#
# 生成新哈希（任意 Linux/容器）：
#   openssl passwd -6
#   # 或
#   python3 -c 'import crypt; print(crypt.crypt("新密码", crypt.mksalt(crypt.METHOD_SHA512)))'

ROOT_HASH='$6$mt76x8$gciVScuwHDoFxwdeXOT74f8aK2QhLFtzPkzpoFGm5h9MHC58emLsBUUDk0wv/kFX0YbiVurZR6e44nos8/yZ..'

[ -f /etc/shadow ] || exit 0
[ -n "$ROOT_HASH" ] || exit 0

# 只补空密码（全新刷机）；保留配置时用户已经改过的密码不能被覆盖。
CURRENT=$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow | head -n 1)
[ -z "$CURRENT" ] || exit 0

# 哈希里可能含 / 和 $，用 | 做分隔符；& 不会出现在 crypt 字母表里。
sed -i "s|^root:[^:]*:|root:${ROOT_HASH}:|" /etc/shadow

exit 0
