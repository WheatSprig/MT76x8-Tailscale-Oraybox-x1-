#!/bin/sh
# 首次开机：把本机配置成办公室局域网里的一台普通主机，而不是网关。
#
# OrayBox X1 只有一个网口，实际用法是插在办公室交换机上：
#   Internet ── 主路由（DHCP 服务器、网关）
#                     │
#                     └── OrayBox X1（Tailscale 子网路由 + 打印）
#
# OpenWrt 默认是 192.168.1.1/24 + 自带 DHCP 服务器，直接插进办公室会和主路由
# 抢地址、抢 DHCP，所以这里必须改掉。
#
# 默认 LAN_MODE='auto'：本机用 DHCP 从主路由拿地址，完全不假设网段，
# 也不用改任何配置。地址可以在主路由的 DHCP 客户端列表里按主机名 mt76x8 找到。
#
# 想要固定地址时，把 LAN_MODE 改成 'static'（构建时用工作流的 lan_mode 输入），
# 并改好 LAN_IP / LAN_GATEWAY。
#
# 刷机后也可以手动改：
#   uci set network.lan.proto='static'
#   uci set network.lan.ipaddr='192.168.1.2'
#   uci set network.lan.gateway='192.168.1.1'
#   uci set network.lan.dns='192.168.1.1'
#   uci commit network && reload_config

LAN_MODE='auto'
LAN_IP='192.168.1.2'
LAN_GATEWAY='192.168.1.1'

[ -f /etc/config/network ] || exit 0

case "$LAN_MODE" in
    static)
        uci -q set network.lan.proto='static'
        uci -q set network.lan.ipaddr="$LAN_IP"
        uci -q set network.lan.netmask='255.255.255.0'
        uci -q set network.lan.gateway="$LAN_GATEWAY"
        uci -q set network.lan.dns="$LAN_GATEWAY"
        ;;
    *)
        # DHCP 客户端：地址、网关、DNS 全部由办公室主路由下发。
        uci -q set network.lan.proto='dhcp'
        uci -q set network.lan.hostname='mt76x8'
        uci -q delete network.lan.ipaddr
        uci -q delete network.lan.netmask
        uci -q delete network.lan.gateway
        uci -q delete network.lan.dns
        ;;
esac

# 这台设备不是网关，IPv6 前缀委派也不需要。
uci -q delete network.lan.ip6assign
uci -q commit network

# 办公室已有主路由负责 DHCP，本机不能再发地址。
if [ -f /etc/config/dhcp ]; then
    uci -q set dhcp.lan.ignore='1'
    uci -q commit dhcp
fi

exit 0
