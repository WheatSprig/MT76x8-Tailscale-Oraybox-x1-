#!/bin/sh
# 首次开机初始化：关闭 LED、启用 Tailscale、启动网页与 Tailnet 反向代理守护。
# 该脚本位于 /etc/uci-defaults/，首次启动执行成功后会被自动删除。

# ---------- 0. 基础系统标识 ----------
# 固件剔除了 default-settings（它依赖 luci），这里补回主机名与时区。
if [ -f /etc/config/system ]; then
    # 只在没有主机名时给默认值：sysupgrade 会保留 /etc/config/system，
    # 每版都硬写会把用户改过的名字重置掉。
    [ -n "$(uci -q get system.@system[0].hostname)" ] \
        || uci -q set system.@system[0].hostname='mt76x8'
    uci -q set system.@system[0].timezone='CST-8'
    uci -q set system.@system[0].zonename='Asia/Shanghai'
fi

# ---------- 0b. 主机名只有一个来源：系统主机名 ----------
# 旧版本把 Tailscale 名字单独存在 /etc/tailscale/hostname。现在统一用系统
# 主机名，升级时把用户已经选好的名字接管过来，再删掉旧文件，避免被重置成
# mt76x8，也避免两个名字长期打架。
if [ -s /etc/tailscale/hostname ]; then
    _old_name=$(head -n 1 /etc/tailscale/hostname 2>/dev/null | tr 'A-Z' 'a-z')
    case "$_old_name" in
        ''|*[!a-z0-9-]*|-*|*-) ;;
        *)
            uci -q set system.@system[0].hostname="$_old_name"
            uci -q commit system
            printf '%s\n' "$_old_name" > /proc/sys/kernel/hostname
            ;;
    esac
    rm -f /etc/tailscale/hostname
fi

# ---------- 1. 所有 LED 保持熄灭 ----------
for led in /sys/class/leds/*; do
    [ -e "$led" ] || continue
    echo none >"$led/trigger" 2>/dev/null
    echo 0 >"$led/brightness" 2>/dev/null
done

# 持久化到 UCI，避免重启后默认 trigger 又把灯点亮。
if [ -f /etc/config/system ]; then
    for section in $(uci -q show system | sed -n 's/^system\.\([^.=]*\)=led$/\1/p'); do
        uci -q delete "system.$section"
    done

    index=0
    for led in /sys/class/leds/*; do
        [ -e "$led" ] || continue
        name="${led##*/}"
        index=$((index + 1))
        uci -q set "system.led_${index}=led"
        uci -q set "system.led_${index}.name=${name}"
        uci -q set "system.led_${index}.sysfs=${name}"
        uci -q set "system.led_${index}.trigger=none"
        uci -q set "system.led_${index}.default=0"
    done
    uci -q commit system
fi

[ -x /etc/init.d/led ] && /etc/init.d/led restart >/dev/null 2>&1

# ---------- 2. Tailscale 服务 ----------
mkdir -p /etc/tailscale
chmod 700 /etc/tailscale
# 首次配置时默认广播本机 LAN 网段；已有配置（升级保留）不覆盖。
if [ ! -f /etc/tailscale/routes ]; then
    : > /etc/tailscale/routes
    : > /etc/tailscale/lan-auto
fi
[ -x /etc/init.d/tailscale ] && /etc/init.d/tailscale enable
# 开机兜底：回滚未确认的 LAN 改动 + 补加救援地址。
[ -x /etc/init.d/lan-guard ] && /etc/init.d/lan-guard enable

# ---------- 2.5 默认关闭出厂 WiFi ----------
# 出厂配置是开放热点 ImmortalWrt，用不上还占内存（wpad + 驱动约 4~8MB）。
# 但如果用户已经配了 STA/AP（例如把 WiFi 当第二条管理链路），升级后不能
# 把它关掉，否则设备就只剩一条路了。
if [ -f /etc/config/wireless ]; then
    _wifi_keep=0
    for _iface in $(uci -q show wireless 2>/dev/null \
        | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
        _mode=$(uci -q get "wireless.$_iface.mode")
        _ssid=$(uci -q get "wireless.$_iface.ssid")
        [ -z "$_mode" ] && continue
        [ "$_mode" = "ap" ] && [ "$_ssid" = "ImmortalWrt" ] && continue
        _wifi_keep=1
    done

    if [ "$_wifi_keep" = "1" ]; then
        logger -t mt76x8 "检测到自定义无线配置，保留 WiFi"
    else
        for dev in $(uci -q show wireless 2>/dev/null \
            | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
            uci -q set "wireless.$dev.disabled='1'"
        done
        uci -q commit wireless
        /etc/init.d/wpad stop >/dev/null 2>&1
        /etc/init.d/wpad disable >/dev/null 2>&1
    fi
fi

# ---------- 3. USB 打印机 -> TCP 9100 ----------
# 板载 USB-A 口在 DTS 里默认启用（ehci/ohci/usbphy 未禁用），
# kmod-usb-printer 提供 /dev/usb/lp0，p910nd 把它映射到 9100 端口。
if [ -x /etc/init.d/p910nd ]; then
    uci -q delete p910nd.printer
    uci -q set p910nd.printer=p910nd
    uci -q set p910nd.printer.device='/dev/usb/lp0'
    uci -q set p910nd.printer.port='0'
    uci -q set p910nd.printer.bidirectional='1'
    uci -q set p910nd.printer.enabled='1'
    uci -q commit p910nd
    /etc/init.d/p910nd enable
    /etc/init.d/p910nd restart >/dev/null 2>&1
fi

# ---------- 4. 子网路由：把办公室局域网发布到 Tailnet ----------
# 记录要发布的网段，供 `tailscale up --advertise-routes` 使用。
#
# DHCP 模式下 uci-defaults 阶段还没有地址（network 还没 ifup），这里只是先把
# 静态配置（如果 LAN_MODE=static）算出来；DHCP 的情况由 rc.local 拿到地址后
# 再刷新。ipcalc.sh 由 base-files 提供，用来把地址/掩码折算成网络地址。
mkdir -p /etc/tailscale

lan_cidr_from_uci() {
    _ip=$(uci -q get network.lan.ipaddr)
    _mask=$(uci -q get network.lan.netmask)
    [ -n "$_ip" ] || return 1
    [ -x /bin/ipcalc.sh ] || return 1
    eval "$(/bin/ipcalc.sh "$_ip" "${_mask:-255.255.255.0}" 2>/dev/null \
        | grep -E '^(NETWORK|PREFIX)=')"
    [ -n "$NETWORK" ] && [ -n "$PREFIX" ] && echo "$NETWORK/$PREFIX"
}

lan_cidr_from_uci > /etc/tailscale/lan-cidr 2>/dev/null

# 作为子网路由需要开启转发，并让 tailscale0 归入 lan 防火墙区域。
echo 1 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
grep -q '^net.ipv4.ip_forward=1$' /etc/sysctl.conf 2>/dev/null \
    || echo 'net.ipv4.ip_forward=1' >> /etc/sysctl.conf

for zone in $(uci -q show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
    [ "$(uci -q get "firewall.$zone.name")" = "lan" ] || continue
    if ! uci -q get "firewall.$zone.device" | grep -qw tailscale0; then
        uci -q add_list "firewall.$zone.device=tailscale0"
    fi
done
uci -q commit firewall

# ---------- 5. Web 控制台（uhttpd） ----------
# uhttpd 同时监听 80 和 8080：80 是 `tailscale serve` 的代理目标，8080 是
# 局域网里直接访问的入口。CGI 放在 /www/cgi-bin，HTTPS 交给 Tailscale。
if [ -f /etc/config/uhttpd ]; then
    uci -q delete uhttpd.main.listen_http
    uci -q add_list uhttpd.main.listen_http='0.0.0.0:80'
    uci -q add_list uhttpd.main.listen_http='0.0.0.0:8080'
    uci -q delete uhttpd.main.listen_https
    uci -q set uhttpd.main.home='/www'
    uci -q set uhttpd.main.cgi_prefix='/cgi-bin'
    # 不列目录（uhttpd 默认就按 index.html 作为首页）。
    uci -q set uhttpd.main.no_dirlists='1'
    # 慢请求不允许多占槽位；固件上传要留足时间（12MB 经 Wi-Fi 可能要一分钟）。
    uci -q set uhttpd.main.max_requests='8'
    uci -q set uhttpd.main.script_timeout='180'
    uci -q commit uhttpd
    /etc/init.d/uhttpd enable
    /etc/init.d/uhttpd restart >/dev/null 2>&1
fi

# ---------- 6. 开机守护：状态缓存 + 网段记录 ----------
# 关键点：后台循环里**一个 tailscale 命令都不跑**。
# CLI 是 22MB 的 Go 程序，580MHz 单核启动一次要十几秒；反复启动会把 CPU
# 打满，tailscaled 的看门狗（30 秒）随即 panic，procd 重启，形成崩溃循环。
# 路由由登录时的 `tailscale up --advertise-routes` 写进 prefs 并持久化，
# `tailscale serve` 改成控制台里的手动按钮。
cat >/etc/rc.local <<'RCLOCAL'
#!/bin/sh
# 由 /etc/uci-defaults/99-tailscale-setup 生成。

# 从 br-lan 当前地址算出要发布的网段。DHCP 的地址可能变，所以每次都要重算。
lan_cidr() {
    _cidr=$(ip -4 addr show dev br-lan 2>/dev/null \
        | sed -n 's/.*inet \([0-9.]*\/[0-9]*\).*/\1/p' | head -n 1)
    [ -n "$_cidr" ] || return 1
    [ -x /bin/ipcalc.sh ] || { echo "$_cidr"; return 0; }
    eval "$(/bin/ipcalc.sh "$_cidr" 2>/dev/null | grep -E '^(NETWORK|PREFIX)=')"
    [ -n "$NETWORK" ] && [ -n "$PREFIX" ] && echo "$NETWORK/$PREFIX"
}

# 把 tailscale 状态落到 /tmp/ts.status（state / ip / auth / updated）。
# 状态全部从日志和接口本身推断，不执行 tailscale：
#   - AuthURL 由 tailscaled 写进 syslog；
#   - 登录成功后内核出现 tailscale0 并带上 100.x 地址。
ts_collect() {
    _auth=$(logread 2>/dev/null \
        | grep -o 'AuthURL is https://[^ ]*' | tail -n 1 | awk '{print $3}')
    # 主动退出登录后，旧日志里的链接不应再显示。
    [ -f /tmp/ts.ignore-auth ] && _auth=""

    _ip=$(ip -4 addr show dev tailscale0 2>/dev/null \
        | sed -n 's/.*inet \([0-9.]*\)\/[0-9]*.*/\1/p' | head -n 1)

    # 未登录时 tailscaled 不会自己生成 AuthURL，光看 socket 会一直显示“启动中”。
    # 从日志里读最后一次状态切换（NoState -> NeedsLogin 之类），这是 daemon
    # 自己报的 BackendState，不依赖 CLI。
    _hint=$(logread 2>/dev/null \
        | grep -o 'Switching ipn state [A-Za-z]* -> [A-Za-z]*' \
        | tail -n 1 | sed 's/.* -> //')

    if [ ! -S /var/run/tailscale/tailscaled.sock ]; then
        # 服务被停掉时日志里还留着上一次的 Running，先看 socket 才不会误报。
        _state="Stopped"
        _auth=""
    elif [ -n "$_ip" ]; then
        _state="Running"
        _auth=""
    elif [ -n "$_auth" ]; then
        _state="NeedsLogin"
    elif [ -n "$_hint" ]; then
        _state="$_hint"
    else
        _state="Starting"
    fi

    _tmp=/tmp/ts.status.$$
    {
        echo "state=$_state"
        echo "ip=$_ip"
        echo "auth=$_auth"
        echo "updated=$(date +%s)"
    } >"$_tmp"
    chmod 644 "$_tmp"
    mv "$_tmp" /tmp/ts.status
}

mkdir -p /etc/tailscale

# 目标广播列表 = （可选）本机 LAN 网段 + 手写网段列表。
routes_wanted() {
    _eff=""
    if [ -f /etc/tailscale/lan-auto ]; then
        _lan=$(lan_cidr)
        [ -n "$_lan" ] && _eff="$_lan"
    fi
    _extra=$(tr '\n' ',' < /etc/tailscale/routes 2>/dev/null | sed 's/,*$//')
    if [ -n "$_eff" ] && [ -n "$_extra" ]; then
        echo "$_eff,$_extra"
    elif [ -n "$_eff" ]; then
        echo "$_eff"
    else
        echo "$_extra"
    fi
}

# 列表变了就重新应用一次。
# 设备搬到别的网络后 br-lan 会变成新网段，而 prefs 里还是旧网段；这里只在
# 「目标列表 != 上次成功广播的列表」时跑一次 CLI，并用 3 分钟退避避免在
# 未登录时反复重试（22MB 的 CLI 反复启动会把 daemon 拖进 watchdog 崩溃循环）。
# 主机名只有一个来源（系统主机名）：离线时改的名字，连上后由这里补同步一次。
hostname_wanted() {
    _h=$(uci -q get system.@system[0].hostname)
    [ -n "$_h" ] || _h=$(cat /proc/sys/kernel/hostname 2>/dev/null)
    [ -n "$_h" ] || _h=mt76x8
    echo "$_h"
}

# 和 api.sh 一样给 CLI 加看门狗：低内存时 tailscale 可能要跑两分钟以上，
# 万一卡死不能让它一直占着 /tmp/ts-cli.lock。
ts_set() {
    "$@" &
    _sp=$!
    ( sleep 150; kill -9 "$_sp" 2>/dev/null ) &
    _sw=$!
    wait "$_sp" 2>/dev/null
    _src=$?
    kill "$_sw" 2>/dev/null
    return $_src
}

apply_prefs() {
    WANT=$(routes_wanted)
    APPLIED=$(cat /etc/tailscale/advertised 2>/dev/null)
    NAME_WANT=$(hostname_wanted)
    NAME_APPLIED=$(cat /etc/tailscale/hostname.applied 2>/dev/null)
    [ -n "$NAME_APPLIED" ] || NAME_APPLIED="$NAME_WANT"
    [ "$WANT" = "$APPLIED" ] && [ "$NAME_WANT" = "$NAME_APPLIED" ] && return 0
    [ -f /tmp/ts-cli.lock ] && return 0

    _last=$(cat /tmp/ts-readvertise.last 2>/dev/null || echo 0)
    _now=$(date +%s)
    [ $((_now - _last)) -lt 180 ] && return 0

    date +%s >/tmp/ts-readvertise.last
    date +%s >/tmp/ts-cli.lock
    (
        # 没登录时不改 prefs：等 tailscale0 出现再动手，最多等 5 分钟。
        _i=0
        while [ "$_i" -lt 60 ]; do
            _ip=$(ip -4 addr show dev tailscale0 2>/dev/null \
                | sed -n 's/.*inet \([0-9.]*\)\/[0-9]*.*/\1/p' | head -n 1)
            [ -n "$_ip" ] && break
            sleep 5
            _i=$((_i + 1))
        done
        if [ -n "$_ip" ]; then
            # 等锁期间用户可能又改过配置，重新读一次，避免用旧值覆盖新值。
            WANT=$(routes_wanted)
            if [ "$WANT" != "$(cat /etc/tailscale/advertised 2>/dev/null)" ]; then
                ts_set tailscale set --advertise-routes="$WANT" >/tmp/ts_setprefs.log 2>&1 \
                    && echo "$WANT" > /etc/tailscale/advertised
            fi
            NAME_WANT=$(hostname_wanted)
            NAME_APPLIED=$(cat /etc/tailscale/hostname.applied 2>/dev/null)
            [ -n "$NAME_APPLIED" ] || NAME_APPLIED="$NAME_WANT"
            if [ "$NAME_WANT" != "$NAME_APPLIED" ]; then
                ts_set tailscale set --hostname="$NAME_WANT" >>/tmp/ts_setprefs.log 2>&1 \
                    && echo "$NAME_WANT" > /etc/tailscale/hostname.applied
            fi
        fi
        rm -f /tmp/ts-cli.lock
    ) &
}

(
    while true; do
        CUR=$(lan_cidr)
        if [ -n "$CUR" ]; then
            echo "$CUR" > /etc/tailscale/lan-cidr
        fi
        apply_prefs
        ts_collect
        sleep 15
    done
) &

exit 0
RCLOCAL
chmod 755 /etc/rc.local

exit 0
