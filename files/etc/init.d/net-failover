#!/bin/sh /etc/rc.common
# 有线不通时自动把默认路由切到 WiFi，恢复后切回。
# 只有在配了 wwan（WiFi STA）的设备上才有实际动作。

START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/lib/net-failover.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
