#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    mkdir -p /etc/tailscale /var/run/tailscale /dev/net
    chmod 700 /etc/tailscale

    # kmod-tun 装了不等于已加载，/dev/net/tun 也不会自己出现；
    # tailscaled 没有它就无法建接口，会一直卡在启动阶段。
    modprobe tun 2>/dev/null
    if [ ! -c /dev/net/tun ]; then
        mknod /dev/net/tun c 10 200 2>/dev/null
        chmod 600 /dev/net/tun 2>/dev/null
    fi

    procd_open_instance
    # 64MB 内存下，GOGC 太低会让 Go 运行时一直 GC；GOMEMLIMIT 也不能压得太狠，
    # 实测 36MiB 时 RSS 只有 17MB 但 CPU 被 GC 抢走。现在给到 48MiB。
    procd_set_param env GOGC=100 GOMEMLIMIT=48MiB
    procd_set_param command /usr/sbin/tailscaled \
        --state=/etc/tailscale/tailscaled.state \
        --socket=/var/run/tailscale/tailscaled.sock \
        --port=41641
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger tailscale
}

reload_service() {
    stop
    start
}
