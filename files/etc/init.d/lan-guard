#!/bin/sh /etc/rc.common
# 改 LAN 地址的守夜人：开机兜底 + 180 秒未确认自动回滚 + 补回救援地址。
# 逻辑都在 /usr/lib/lan-guard.sh，这里只负责常驻。

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/lib/lan-guard.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
