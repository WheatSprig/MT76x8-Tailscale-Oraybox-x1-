#!/bin/sh /etc/rc.common
# 开机兜底：
#   1. 上一次改 LAN 地址后没确认就重启/断电 → 先回滚，再让网络正常起来；
#   2. 如果有待确认的改动，把改动前的地址补回去（改错网段时还能从旧地址进）；
#   3. 救援地址（192.168.1.2/24）是手工加的地址，reload 会清掉，这里补回来。

START=95
USE_PROCD=0

start() {
    /usr/lib/lan-rollback.sh check

    if [ -f /etc/lan-pending ]; then
        OLD_IP=$(sed -n '3p' /etc/lan-pending 2>/dev/null)
        OLD_PFX=$(sed -n '4p' /etc/lan-pending 2>/dev/null)
        if [ -n "$OLD_IP" ] && [ -n "$OLD_PFX" ]; then
            ip addr add "$OLD_IP/$OLD_PFX" brd + dev br-lan 2>/dev/null
        fi
    fi

    [ -f /etc/lan-rescue ] || return 0
    ip addr add 192.168.1.2/24 brd + dev br-lan 2>/dev/null
    return 0
}
