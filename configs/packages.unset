# 需要从默认包里剔除的包（一行一个，以 `-` 开头）
#
# 用途：源码构建时转成 CONFIG_PACKAGE_<name>=n，效果与 ImageBuilder 的
# `-<name>` 完全一致。ImageBuilder 流水线目前用的是同一份列表的硬编码版本，
# 两者改动必须同步。
#
# --- LuCI 及其依赖回填入口 ---
# 只关 CONFIG_PACKAGE_luci 不够：default-settings 直接依赖 luci，
# default-settings-chn 依赖 luci-i18n-base-zh-cn，luci-app-opkg/luci-compat/
# luci-lib-ipkg 依赖 luci-base，kconfig 会把它们重新选上。
-luci
-luci-base
-luci-ssl
-luci-compat
-luci-app-firewall
-luci-app-opkg
-luci-lib-base
-luci-lib-ipkg
-default-settings
-default-settings-chn
# --- IPv6 / PPPoE：家用子网路由场景用不到 ---
-ipv6helper
-odhcp6c
-odhcpd-ipv6only
-ip6tables
-ppp
-ppp-mod-pppoe
# --- OpenSSL 栈：换 mbedtls 后整个 1.5 MiB 不再进固件 ---
# libustream 有两层：选择器（libustream-openssl）+ 实现包
# （libustream-openssl20201210），两个都要关，否则选择器会把实现包拉回来并和
# mbedtls 版抢 /lib/libustream-ssl.so。
-wpad-basic-openssl
-libustream-openssl
-libustream-openssl20201210
